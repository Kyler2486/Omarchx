#!/bin/bash

# omarchx:summary=Display brightness level using SwayOSD on the current monitor.
# omarchx:args=<0-100>
# omarchx:examples=omarchx swayosd brightness 0 | omarchx swayosd brightness 50 | omarchx swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

omarchx-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "$(printf '%3d%%' "$percent")"
