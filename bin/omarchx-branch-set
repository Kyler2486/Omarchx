#!/bin/bash

# omarchx:summary=Set the branch for Omarchx's git repository.
# omarchx:args=<master|rc|dev>

if (($# == 0)); then
  echo "Usage: omarchx-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $OMARCHX_PATH switch $branch
