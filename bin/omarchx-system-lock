#!/bin/bash

# omarchx:summary=Lock the computer and turn off the display
# omarchx:group=system
# omarchx:name=lock
# omarchx:examples=omarchx system lock

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    omarchx-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.omarchx.screensaver

if [[ ${OMARCHX_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    omarchx-brightness-keyboard off
    omarchx-brightness-display off
  ) &
fi
