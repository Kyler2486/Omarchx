#!/bin/bash

# omarchx:summary=List available themes
# omarchx:examples=omarchx theme list | omarchx theme set "Tokyo Night"

{
  find ~/.config/omarchx/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$OMARCHX_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
