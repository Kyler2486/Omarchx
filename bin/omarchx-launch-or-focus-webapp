#!/bin/bash

# omarchx:summary=Launch or focus on a given web app identified by the window-pattern.
# omarchx:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: omarchx-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="omarchx-launch-webapp $@"

exec omarchx-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
