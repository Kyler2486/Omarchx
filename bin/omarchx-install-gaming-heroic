#!/bin/bash

# omarchx:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# omarchx:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
omarchx-pkg-add heroic-games-launcher-bin
omarchx-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &
