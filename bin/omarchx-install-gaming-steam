#!/bin/bash

# omarchx:summary=Install Steam and graphics drivers selected for this system
# omarchx:requires-sudo=true

set -e

echo "Installing Steam..."
omarchx-pkg-add steam
omarchx-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &
