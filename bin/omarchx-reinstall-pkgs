#!/bin/bash

# omarchx:summary=Reinstall all default Omarchx packages from the stable channel
# omarchx:requires-sudo=true

set -e

# Reinstall all default Omarchx packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
omarchx-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$OMARCHX_PATH/install/omarchx-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
