#!/bin/bash

# omarchx:summary=Set the Omarchx channel, which dictates what git branch and package repository is used.
# omarchx:args=<stable|rc|edge|dev>
# omarchx:requires-sudo=true

if (($# == 0)); then
  echo "Usage: omarchx-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") omarchx-branch-set "master" && omarchx-refresh-pacman "stable" ;;
"rc") omarchx-branch-set "rc" && omarchx-refresh-pacman "rc" ;;
"edge") omarchx-branch-set "master" && omarchx-refresh-pacman "edge" ;;
"dev") omarchx-branch-set "dev" && omarchx-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

omarchx-update -y
