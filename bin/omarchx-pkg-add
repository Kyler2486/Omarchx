#!/bin/bash

# omarchx:summary=Install Arch packages if they are missing
# omarchx:args=<packages...>
# omarchx:examples=omarchx pkg add jq ripgrep
# omarchx:requires-sudo=true

if omarchx-pkg-missing "$@"; then
  sudo pacman -S --disable-sandbox --noconfirm --needed "$@" || exit 1
fi

for pkg in "$@"; do
  if ! pacman -Q "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
