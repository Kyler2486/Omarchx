#!/bin/bash

# omarchx:summary=Log out after closing application windows
# omarchx:examples=omarchx logout | omarchx system logout
# omarchx:aliases=omarchx logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

# Now close all windows
omarchx-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
