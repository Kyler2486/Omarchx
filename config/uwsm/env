# Changes require a restart to take effect.

# Ensure Omarchx bins are in the path
export OMARCHX_PATH=$HOME/.local/share/omarchx
export PATH=$OMARCHX_PATH/bin:$PATH:$HOME/.local/bin

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
omarchx-cmd-present mise && eval "$(mise activate bash --shims)"
